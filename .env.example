# Copy to .env and fill in. Never commit .env.
# Supabase > Project Settings > Database > Connection string (URI). Use the "Session pooler" one.
DATABASE_URL=postgresql://postgres.xxxxx:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# console.anthropic.com > API keys. Optional: without it, issues get rule-based labels.
ANTHROPIC_API_KEY=
# Optional tuning
# EARSHOT_TOP_COMPANIES=8
# EARSHOT_YEARS=3
# EARSHOT_MERGE_SIM=0.45
