{
  "hosting": {
    "public": "web/out",
    "cleanUrls": true,
    "trailingSlash": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "/data/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "/_next/static/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
